# ============================================================
#  LICITRA — .gitignore
# ============================================================

# ── Variables de entorno (NUNCA subir claves al repo) ──────
.env
.env.local
.env.*.local
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local

# ── Dependencias ───────────────────────────────────────────
node_modules/
backend/node_modules/
frontend/node_modules/

# ── Build / dist ───────────────────────────────────────────
frontend/dist/
frontend/.vite/
dist/

# ── Logs ───────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Archivos temporales y subidas ──────────────────────────
uploads/
tmp/
*.tmp
*.bak

# ── Editores e IDEs ────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Archivos de sesión Express (si se usa store en fichero) ─
sessions/
