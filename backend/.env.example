# ============================================================
#  LICITRA — Variables de entorno del backend
#  Copia este archivo como ".env" y rellena los valores reales.
#  NUNCA subas el archivo ".env" a GitHub.
# ============================================================

# Puerto del servidor Express
PORT=3000

# URL del frontend (para CORS en desarrollo)
FRONTEND_URL=http://localhost:5173

# Clave secreta para firmar las cookies de sesión
# Genera una larga y aleatoria: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-esto-por-una-clave-segura

# ── Supabase ────────────────────────────────────────────────
# Encuéntralos en: Supabase Dashboard → Settings → API
SUPABASE_URL=https://TU-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=eyJ...tu-anon-key...
SUPABASE_SERVICE_ROLE_KEY=eyJ...tu-service-role-key...

# Cadena de conexión PostgreSQL directa (para sesiones persistentes)
# Encuéntrala en: Supabase Dashboard → Settings → Database → Connection string → URI
# Usa el puerto 6543 (Transaction mode) para compatibilidad con serverless/pooling
DATABASE_URL=postgresql://postgres.TU-PROJECT-REF:TU-PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# ── Groq API (IA) ───────────────────────────────────────────
# Obtén tu clave en: https://console.groq.com/keys
GROQ_API_KEY=gsk_...tu-api-key...
GROQ_MODEL=llama-3.3-70b-versatile

# ── Email (Resend) ───────────────────────────────────────────
# Obtén tu clave en: https://resend.com/api-keys
# En el tier gratuito puedes enviar desde onboarding@resend.dev sin verificar dominio.
# Para producción, verifica tu dominio en Resend y cambia FROM_EMAIL.
RESEND_API_KEY=re_...tu-api-key...
FROM_EMAIL=LICITRA <onboarding@resend.dev>
